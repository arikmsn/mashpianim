# Supabase
NEXT_SUPABASE_URL=https://your-project.supabase.co
NEXT_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SEC_KEY=your-service-role-key

# GreenAPI (WhatsApp OTP)
GREENAPI_INSTANCE_ID=your-instance-id
GREENAPI_API_TOKEN=your-api-token

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com

# SUMIT (online purchase of credit packages — hosted payment page + invoice-receipt)
# SUMIT_PAYMENTS: off (default) | admins (only admin accounts see the purchase flow) | on (every business)
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
SUMIT_PAYMENTS=off

# WhatsApp digests through GreenAPI (creators daily at 18:00 Israel, businesses Sunday 10:00):
# off (default) | dry (compose + log only — review in /admin/messages) | on
WHATSAPP_DIGESTS=off
# SMS digests for phones with no WhatsApp chat (off = skip them): on by default
DIGEST_SMS=on

# Login code routing: WhatsApp for phones with an existing chat, SMS for everyone else (off = OTP_DEFAULT_CHANNEL alone)
OTP_SMART_CHANNEL=on
