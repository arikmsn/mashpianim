# Supabase
NEXT_SUPABASE_URL=https://your-project.supabase.co
NEXT_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SEC_KEY=your-service-role-key

# GreenAPI (WhatsApp OTP)
GREENAPI_INSTANCE_ID=your-instance-id
GREENAPI_API_TOKEN=your-api-token

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com

# SUMIT (online purchase of credit packages — hosted payment page + invoice-receipt)
# SUMIT_PAYMENTS: off (default) | admins (only admin accounts see the purchase flow) | on (every business)
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
SUMIT_PAYMENTS=off
